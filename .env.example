# Copy to .env and fill in. Only PUBLIC_* values reach the browser.
#
# Nothing here is required. The Turnstile site key lives in src/data/contact.ts, because
# it is public and every build needs it; set this only to point a build at a different
# widget than the production one.
PUBLIC_TURNSTILE_SITE_KEY=

# The Worker's own secrets are never read from here. They live in Cloudflare:
#   npx wrangler secret put TURNSTILE_SECRET_KEY
#   npx wrangler secret put RESEND_API_KEY
