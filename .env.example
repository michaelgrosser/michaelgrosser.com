# Copy to .env and fill in. Only PUBLIC_* values reach the browser.

# Cloudflare Turnstile site key for michaelgrosser.com. Public by design; the secret
# half lives in Cloudflare (`wrangler secret put TURNSTILE_SECRET_KEY`).
#
# Leave this unset for local work and tests: the build falls back to Cloudflare's
# always-passes test key and says so loudly. `npm run deploy` refuses such a build.
PUBLIC_TURNSTILE_SITE_KEY=

# The Worker's own secrets are never read from here. They live in Cloudflare:
#   npx wrangler secret put TURNSTILE_SECRET_KEY
#   npx wrangler secret put RESEND_API_KEY
