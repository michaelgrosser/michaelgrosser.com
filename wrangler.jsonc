{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "michaelgrosser-com",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",

  // www is the canonical host: every canonical URL, og:url and the sitemap point at it,
  // and the apex redirects to it with a Cloudflare redirect rule. Declaring it here means
  // `wrangler deploy` attaches the hostname rather than someone doing it by hand.
  "routes": [{ "pattern": "www.michaelgrosser.com", "custom_domain": true }],

  // No *.workers.dev route: a second origin serving the same pages is a second thing
  // for search engines to index and for anyone to link to.
  "workers_dev": false,

  // Static Astro output is served from the edge, and the asset layer answers first.
  //
  // `404-page` keeps unmatched paths — /wp-admin, /.env, every bot probe — on the free
  // asset path instead of spending a Worker invocation to say "not found".
  //
  // That alone would swallow /api/contact too, since it matches no asset, so
  // `run_worker_first` carves out the one path that must reach the Worker. It is listed
  // exactly rather than as /api/*, so probes at other /api paths stay free as well.
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/contact"],
  },

  // Non-secret configuration. TURNSTILE_SECRET_KEY and RESEND_API_KEY are secrets: they
  // live in Cloudflare, never here. `npx wrangler secret put <NAME>`, or the dashboard.
  //
  // Mail goes through Resend rather than Cloudflare Email, because Email Routing would
  // require this domain's MX records to point at Cloudflare and they already point at a
  // mailbox provider. Resend verifies sending with records under send.<domain>.
  //
  // Sender and recipient are the same address on purpose: it is the one address this
  // site publishes, and the visitor's address goes in Reply-To rather than From.
  "vars": {
    "CONTACT_FROM": "michael@michaelgrosser.com",
    "CONTACT_TO": "michael@michaelgrosser.com",
  },

  "observability": {
    "enabled": true,
  },
}
