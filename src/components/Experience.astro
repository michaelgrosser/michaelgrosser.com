---
/** 01 / Experience — the timeline, and the page's signature hover. */
import { roles, experienceRange } from '../data/experience';
---

<section id="experience" class="experience" aria-labelledby="experience-heading">
  <div class="container">
    <div class="section-rule experience__header">
      <h2 class="type-mono type-mono-tracked" id="experience-heading">01 / Experience</h2>
      <span class="section-rule__line"></span>
      <p class="type-mono">{experienceRange}</p>
    </div>

    <ol class="experience__list">
      {
        roles.map((role) => (
          <li class="role" data-review="experience-row">
            <p class="role__year type-numeral">{role.year}</p>
            <div class="role__detail">
              <span class:list={['role__dot', { 'role__dot--current': role.current }]} />
              <h3 class="type-title">{role.title}</h3>
              <p class="type-mono type-mono-meta">
                {role.company} · {role.range}
              </p>
              <p class="type-body role__summary">{role.summary}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .experience {
    padding-block: var(--section-padding-block) 0;
  }

  .experience__header {
    margin-bottom: var(--space-10);
  }

  .experience__list {
    display: flex;
    flex-direction: column;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .role {
    display: grid;
    grid-template-columns: var(--timeline-column) 1fr;
    /* Bleeds 20px left of the container edge so the hover tint frames the row. */
    margin-left: calc(-1 * var(--space-5));
    padding: var(--space-5) var(--space-5) var(--space-5) 0;
    border-radius: var(--radius-md);
    transition:
      background var(--duration-standard) var(--easing),
      transform var(--duration-standard) var(--easing);
  }

  .role:hover {
    background: var(--color-surface-accent);
    transform: translateX(4px);
  }

  .role__year {
    padding-left: var(--space-5);
  }

  .role__detail {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding-left: var(--space-10);
    border-left: var(--border-width-hairline) solid var(--color-border);
  }

  .role__dot {
    position: absolute;
    top: var(--space-2);
    left: -4px;
    width: 7px;
    height: 7px;
    background: var(--color-border-strong);
    border-radius: var(--radius-sm);
  }

  .role__dot--current {
    background: var(--color-accent);
  }

  .role__summary {
    max-width: var(--measure-body);
  }

  @media (max-width: 1000px) {
    .role {
      grid-template-columns: var(--timeline-column-compact) 1fr;
    }

    .role__year {
      font-size: var(--text-numeral-compact);
    }
  }

  @media (max-width: 700px) {
    .role {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }

    .role__detail {
      padding-left: var(--space-5);
    }
  }
</style>
