---
/** 04 / Contact — copy on the left, the form on the right. */
import ContactForm from './ContactForm.astro';
import SocialLinks from './SocialLinks.astro';
---

<section id="contact" class="contact" aria-labelledby="contact-heading">
  <div class="container contact__grid">
    <div class="contact__intro">
      <h2 class="type-mono type-mono-tracked" id="contact-heading">04 / Contact</h2>
      <p class="type-heading">Happy to talk systems, teams, or AI-assisted delivery.</p>
      <p class="type-body contact__copy">
        The form reaches me directly. I&rsquo;m also easy to find in the usual places.
      </p>
      <SocialLinks />
    </div>

    <ContactForm />
  </div>
</section>

<style>
  .contact {
    background: var(--color-surface);
    border-top: var(--border-width-hairline) solid var(--color-border);
    padding-block: var(--section-padding-block);
  }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-24);
  }

  .contact__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .contact__copy {
    max-width: var(--measure-narrow);
  }

  @media (max-width: 1000px) {
    .contact__grid {
      grid-template-columns: 1fr;
      gap: var(--space-12);
    }
  }
</style>
