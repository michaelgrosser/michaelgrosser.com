---
/**
 * The document shell: metadata, self-hosted fonts, the global stylesheets, and the
 * page chrome. Every route gets its head tags from here so nothing drifts.
 */
import '../styles/tokens.css';
import '../styles/typography.css';
import '../styles/global.css';
import '../styles/utilities.css';

import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site, socialLinks } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description = site.description, image = '/og-image.jpg' } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const imageUrl = new URL(image, Astro.site ?? site.url);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: site.url,
  image: imageUrl.href,
  email: `mailto:${site.email}`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Chicago',
    addressRegion: 'IL',
    addressCountry: 'US',
  },
  sameAs: socialLinks.filter((link) => link.href.startsWith('http')).map((link) => link.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f7f8fa" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!--
      No font preloads. They are High priority and sit ahead of the hero image in the byte
      stream, and on a throttled connection ~48 kB of fonts pushed the LCP image's request
      out by more than half a second. The faces still load from the stylesheet, and
      font-display: swap paints the text immediately either way.
    -->

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:alt" content={`Portrait of ${site.name}`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl.href} />

    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} is:inline />
  </head>

  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
